# Copy this file to .env (same folder) and paste your key after the = sign.
# Get a free key at https://aistudio.google.com/apikey
# Without a key the app uses the offline template writer.
GEMINI_API_KEY=

# Optional: model order. A 429 or 5xx moves to the next model.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# Optional: free-tier requests per model per day, for the "calls left" counter.
GEMINI_DAILY_LIMIT=20
