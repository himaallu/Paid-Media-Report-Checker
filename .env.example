# Gemini API key from https://aistudio.google.com/apikey (free tier works).
# Without it the app uses the offline template writer.
GEMINI_API_KEY=
# Optional: model order. A 429 or 5xx moves to the next model.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
